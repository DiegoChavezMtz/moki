# Supabase > Project Settings > API: URL y clave publicable (no secret/service_role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Service role para eliminar una cuenta desde la ruta autenticada.
SUPABASE_SERVICE_ROLE_KEY=

# Solo servidor. Nunca usar NEXT_PUBLIC_ para la clave de MiniMax.
MINIMAX_API_KEY=
# ID de un modelo habilitado en tu cuenta de MiniMax, por ejemplo MiniMax-M2.7.
MINIMAX_MODEL=

# Solo servidor. Clave de Brave Search para el bloque "Buscar en internet".
BRAVE_SEARCH_API_KEY=
